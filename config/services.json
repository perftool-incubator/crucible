{
    "cdm-server": {
        "port": 3000
    },
    "mcp-server": {
        "enabled": false,
        "bind": "127.0.0.1",
        "port": 8889,
        "transport": "streamable-http",
        "token-file": "/etc/crucible/mcp-server.token",
        "database": "/var/lib/crucible/mcp/jobs.db",
        "input-root": "/var/lib/crucible/mcp/inputs",
        "max-inline-bytes": 1048576,
        "max-run-file-bytes": 1048576,
        "cdm-readiness-timeout": 60,
        "audit-log": "/var/lib/crucible/logs/mcp-audit.jsonl",
        "audit-max-bytes": 10485760,
        "audit-retained-files": 5
    },
    "httpd": {
        "port": 8080
    },
    "image-sourcing": {
        "use": true,
        "services": {
            "default": {
                "start": true,
                "location": {
                    "address": "localhost",
                    "port": 8888,
                    "protocol": "http"
                }
            }
        }
    },
    "opensearch": {
        "instances": [
            {
                "name": "local-v8",
                "host": "localhost:9200",
                "cdmver": "v8dev"
            },
            {
                "name": "local-v9",
                "host": "localhost:9200",
                "cdmver": "v9dev"
            },
            {
                "name": "local-v10",
                "host": "localhost:9200",
                "cdmver": "v10dev"
            }
        ],
        "index-to": "local-v10",
        "query-from": [
            "local-v10",
            "local-v9",
            "local-v8"
        ]
    },
    "valkey": {
        "monitor": {
            "enabled": false
        }
    },
    "remote-archive": {
        "remotes": {},
        "default": null
    }
}
